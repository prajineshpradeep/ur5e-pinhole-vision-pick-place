<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="custom_gripper" params="prefix:='' parent:='tool0' *origin">
    <material name="${prefix}gripper_dark">
      <color rgba="0.14 0.16 0.19 1.0"/>
    </material>
    <material name="${prefix}gripper_accent">
      <color rgba="0.90 0.38 0.12 1.0"/>
    </material>
    <material name="${prefix}gripper_rail">
      <color rgba="0.82 0.84 0.87 1.0"/>
    </material>
    <material name="${prefix}gripper_pad">
      <color rgba="0.08 0.08 0.09 1.0"/>
    </material>
    <material name="${prefix}camera_lens">
      <color rgba="0.06 0.18 0.38 1.0"/>
    </material>

    <!-- Mount gripper_base onto parent flange/tool0 -->
    <joint name="${prefix}gripper_mount_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${prefix}gripper_base"/>
    </joint>

    <link name="${prefix}gripper_base">
      <!-- Mounting flange collar -->
      <visual>
        <origin xyz="0 0 0.010" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.038" length="0.020"/>
        </geometry>
        <material name="${prefix}gripper_accent"/>
      </visual>
      <!-- Main actuator housing -->
      <visual>
        <origin xyz="0 0 0.048" rpy="0 0 0"/>
        <geometry>
          <box size="0.116 0.048 0.056"/>
        </geometry>
        <material name="${prefix}gripper_dark"/>
      </visual>
      <!-- Dual linear guide rails -->
      <visual>
        <origin xyz="0 -0.013 0.074" rpy="0 1.5707963 0"/>
        <geometry>
          <cylinder radius="0.005" length="0.112"/>
        </geometry>
        <material name="${prefix}gripper_rail"/>
      </visual>
      <visual>
        <origin xyz="0 0.013 0.074" rpy="0 1.5707963 0"/>
        <geometry>
          <cylinder radius="0.005" length="0.112"/>
        </geometry>
        <material name="${prefix}gripper_rail"/>
      </visual>
      <!-- Center status strip -->
      <visual>
        <origin xyz="0 0 0.068" rpy="0 0 0"/>
        <geometry>
          <box size="0.024 0.050 0.012"/>
        </geometry>
        <material name="${prefix}gripper_accent"/>
      </visual>
      <!-- Eye-in-hand wrist pinhole camera housing + lens -->
      <visual>
        <origin xyz="0 -0.038 0.046" rpy="0 0 0"/>
        <geometry>
          <box size="0.036 0.030 0.024"/>
        </geometry>
        <material name="${prefix}gripper_dark"/>
      </visual>
      <visual>
        <origin xyz="0 -0.042 0.060" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.009" length="0.012"/>
        </geometry>
        <material name="${prefix}camera_lens"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.044" rpy="0 0 0"/>
        <geometry>
          <box size="0.120 0.076 0.072"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.045" rpy="0 0 0"/>
        <mass value="0.65"/>
        <inertia ixx="0.0012" ixy="0.0" ixz="0.0" iyy="0.0012" iyz="0.0" izz="0.0008"/>
      </inertial>
    </link>

    <!-- Wrist pinhole camera optical frame (+Z along tool axis, +X right, +Y down) -->
    <link name="${prefix}wrist_cam_optical_frame"/>
    <joint name="${prefix}wrist_cam_joint" type="fixed">
      <origin xyz="0 -0.045 0.066" rpy="0 0 0"/>
      <parent link="${prefix}gripper_base"/>
      <child link="${prefix}wrist_cam_optical_frame"/>
    </joint>

    <!-- Tool Center Point (TCP) between fingertip pads -->
    <link name="${prefix}pinch_tcp"/>
    <joint name="${prefix}pinch_tcp_joint" type="fixed">
      <origin xyz="0 0 0.158" rpy="0 0 0"/>
      <parent link="${prefix}gripper_base"/>
      <child link="${prefix}pinch_tcp"/>
    </joint>

    <!-- Left Custom Parallel Finger -->
    <link name="${prefix}left_finger">
      <!-- Finger carriage -->
      <visual>
        <origin xyz="-0.015 0 0.004" rpy="0 0 0"/>
        <geometry>
          <box size="0.024 0.036 0.024"/>
        </geometry>
        <material name="${prefix}gripper_dark"/>
      </visual>
      <!-- Brushed aluminum structural blade -->
      <visual>
        <origin xyz="-0.013 0 0.046" rpy="0 0 0"/>
        <geometry>
          <box size="0.012 0.028 0.072"/>
        </geometry>
        <material name="${prefix}gripper_rail"/>
      </visual>
      <!-- Orange accent bracket -->
      <visual>
        <origin xyz="-0.016 0 0.032" rpy="0 0 0"/>
        <geometry>
          <box size="0.014 0.030 0.020"/>
        </geometry>
        <material name="${prefix}gripper_accent"/>
      </visual>
      <!-- Contoured high-friction fingertip pad -->
      <visual>
        <origin xyz="-0.0045 0 0.082" rpy="0 0 0"/>
        <geometry>
          <box size="0.009 0.030 0.044"/>
        </geometry>
        <material name="${prefix}gripper_pad"/>
      </visual>
      <collision>
        <origin xyz="-0.012 0 0.052" rpy="0 0 0"/>
        <geometry>
          <box size="0.024 0.036 0.104"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="-0.015 0 0.045" rpy="0 0 0"/>
        <mass value="0.12"/>
        <inertia ixx="0.00015" ixy="0.0" ixz="0.0" iyy="0.00015" iyz="0.0" izz="0.00005"/>
      </inertial>
    </link>
    <joint name="${prefix}left_finger_joint" type="prismatic">
      <origin xyz="0 0 0.074" rpy="0 0 0"/>
      <parent link="${prefix}gripper_base"/>
      <child link="${prefix}left_finger"/>
      <axis xyz="-1 0 0"/>
      <limit lower="0.0" upper="0.044" effort="100.0" velocity="0.2"/>
    </joint>

    <!-- Right Custom Parallel Finger (symmetrically mimics left_finger_joint) -->
    <link name="${prefix}right_finger">
      <visual>
        <origin xyz="0.015 0 0.004" rpy="0 0 0"/>
        <geometry>
          <box size="0.024 0.036 0.024"/>
        </geometry>
        <material name="${prefix}gripper_dark"/>
      </visual>
      <visual>
        <origin xyz="0.013 0 0.046" rpy="0 0 0"/>
        <geometry>
          <box size="0.012 0.028 0.072"/>
        </geometry>
        <material name="${prefix}gripper_rail"/>
      </visual>
      <visual>
        <origin xyz="0.016 0 0.032" rpy="0 0 0"/>
        <geometry>
          <box size="0.014 0.030 0.020"/>
        </geometry>
        <material name="${prefix}gripper_accent"/>
      </visual>
      <visual>
        <origin xyz="0.0045 0 0.082" rpy="0 0 0"/>
        <geometry>
          <box size="0.009 0.030 0.044"/>
        </geometry>
        <material name="${prefix}gripper_pad"/>
      </visual>
      <collision>
        <origin xyz="0.012 0 0.052" rpy="0 0 0"/>
        <geometry>
          <box size="0.024 0.036 0.104"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.015 0 0.045" rpy="0 0 0"/>
        <mass value="0.12"/>
        <inertia ixx="0.00015" ixy="0.0" ixz="0.0" iyy="0.00015" iyz="0.0" izz="0.00005"/>
      </inertial>
    </link>
    <joint name="${prefix}right_finger_joint" type="prismatic">
      <origin xyz="0 0 0.074" rpy="0 0 0"/>
      <parent link="${prefix}gripper_base"/>
      <child link="${prefix}right_finger"/>
      <axis xyz="1 0 0"/>
      <limit lower="0.0" upper="0.044" effort="100.0" velocity="0.2"/>
      <mimic joint="${prefix}left_finger_joint" multiplier="1.0" offset="0.0"/>
    </joint>
  </xacro:macro>

</robot>
